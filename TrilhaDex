function Do.findReferences(target)
    if not getgc then
        return "-- Get Lua References needs getgc"
    end
    local out = { "-- Lua references to " .. getPath(target), "" }
    local count = 0
    local owned = { [nodes] = true, [selection] = true, [selectedSet] = true, [hiddenItems] = true, [out] = true }
    local readUpvalues = getupvalues or (debug and debug.getupvalues)
    local objects = getgc(true)
    owned[objects] = true
    -- FilesGame's own lists, so they don't show up as references.
    for _, list in ipairs({ clip, clip.items, results or false, visibleRows or false, propRows }) do
        if list then
            owned[list] = true
        end
    end
    for _, entry in pairs(hiddenItems) do
        owned[entry] = true
        owned[entry.list] = true
        for _, item in ipairs(entry.list) do
            owned[item] = true
        end
    end
    local function isOwnShape(object)
        -- Explorer nodes, search nodes and property rows.
        return (rawget(object, "inst") ~= nil and (rawget(object, "depth") ~= nil or rawget(object, "isSearch") ~= nil or rawget(object, "expanded") ~= nil))
            or rawget(object, "insts") ~= nil
            or (rawget(object, "direction") ~= nil and rawget(object, "method") ~= nil)
    end

    for i, object in ipairs(objects) do
        if i % 20000 == 0 then
            task.wait()
        end
        if count >= 300 then
            table.insert(out, "-- limit reached")
            break
        end
        local kind = type(object)
        local okShape, ownShape = false, false
        if kind == "table" and not owned[object] then
            okShape, ownShape = pcall(isOwnShape, object)
        end
        if kind == "table" and not owned[object] and not (okShape and ownShape) then
            pcall(function()
                for key, value in next, object do
                    if rawequal(value, target) or rawequal(key, target) then
                        count += 1
                        table.insert(out, ("table %s  field [%s]"):format(tostring(object), tostring(key)))
                    end
                end
            end)
        elseif kind == "function" and readUpvalues and (not islclosure or islclosure(object)) then
            local ok, upvalues = pcall(readUpvalues, object)
            if ok and type(upvalues) == "table" then
                for index, value in pairs(upvalues) do
                    if rawequal(value, target) then
                        count += 1
                        local source, line, name = debug.info(object, "sln")
                        table.insert(out, ("upvalue %s of %s at %s:%s"):format(
                            tostring(index), name ~= "" and name or "<anonymous>", source, line))
                    end
                end
            end
        end
    end
    if count == 0 then
        table.insert(out, "-- none found")
    end
    return table.concat(out, "\n")
end

