    -- Every Lua function that belongs to the script, with its constants and upvalues.
    local function dumpFunctions(inst)
        if not getgc then
            return "-- Dump needs getgc"
        end
        local fullName = inst:GetFullName()
        local readConstants = getconstants or (debug and debug.getconstants)
        local readUpvalues = getupvalues or (debug and debug.getupvalues)
        local out, count = { "-- Functions of " .. fullName, "" }, 0

        local function short(v)
            local okShort, text = pcall(function()
                local t = typeof(v)
                if t == "string" then
                    return ("%q"):format(v:sub(1, 80))
                end
                if t == "Instance" then
                    return v:GetFullName()
                end
                return tostring(v)
            end)
            return okShort and text or "?"
        end

        for i, f in ipairs(getgc()) do
            if i % 20000 == 0 then
                task.wait()
            end
            if type(f) == "function" and (not islclosure or islclosure(f)) then
                local source, line, name = debug.info(f, "sln")
                if source and source:find(fullName, 1, true) then
                    count += 1
                    if count > 400 then
                        table.insert(out, "-- limit reached")
                        break
                    end
                    table.insert(out, ("function %s -- line %d"):format(name ~= "" and name or "<anonymous>", line))
                    for _, reader in ipairs({ { "constants", readConstants }, { "upvalues", readUpvalues } }) do
                        local okRead, values = pcall(reader[2] or error, f)
                        if okRead and type(values) == "table" and next(values) ~= nil then
                            table.insert(out, "    " .. reader[1] .. ":")
                            local shown = 0
                            for key, value in pairs(values) do
                                shown += 1
                                if shown > 60 then
                                    break
                                end
                                table.insert(out, ("        [%s] %s"):format(tostring(key), short(value)))
                            end
                        end
                    end
                    table.insert(out, "end")
                    table.insert(out, "")
                end
            end
        end
        if count == 0 then
            table.insert(out, "-- No functions found. The script may not be running yet.")
        end
        return table.concat(out, "\n")
    end

    function Viewer.dump(inst, forcedPane)
        viewLater(inst.Name .. " (functions)", function()
            return dumpFunctions(inst)
        end, nil, forcedPane)
    end

