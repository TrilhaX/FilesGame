    updateCanvas()
    render()
end

function Do.encodeBase64(data)
    local encoder = (crypt and (crypt.base64encode or crypt.base64 and crypt.base64.encode))
        or base64encode or (base64 and base64.encode)
    if encoder then
        return encoder(data)
    end
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local out = {}
    for i = 1, #data, 3 do
        local a, b, c = data:byte(i, i + 2)
        local n = a * 65536 + (b or 0) * 256 + (c or 0)
        local chars = {}
        for shift = 3, 0, -1 do
            local v = math.floor(n / 64 ^ shift) % 64
            chars[4 - shift] = alphabet:sub(v + 1, v + 1)
        end
        if not b then chars[3] = "=" end
        if not c then chars[4] = "=" end
        table.insert(out, table.concat(chars))
    end
    return table.concat(out)
end

-- Members of a class from the embedded API: events (#E) or functions (#F).
function Do.membersOf(className, tag)
    local names, seen = {}, {}
    local current = API[className] and className or "Instance"
    while current and API[current] do
        local data = API[current]
        local chunk = data.txt:match("%f[#]" .. tag .. "=([^;]*)")
        if chunk then
            for raw in chunk:gmatch("[^,]+") do
                local deprecated = raw:sub(-1) == "~"
                local item = deprecated and raw:sub(1, -2) or raw
                local name = item:match("^[^/]+")
                if not seen[name] and (settings.showDeprecated or not deprecated) then
                    seen[name] = true
                    table.insert(names, item)
                end
            end
        end
        current = data.parent ~= "" and data.parent or nil
    end
    table.sort(names)
    return names
end

function Do.describeHandler(connection)
    local func = connection.Function
    local parts = { connection.Enabled == false and "disabled" or "enabled" }
    if connection.ForeignState then
        table.insert(parts, "foreign")
    end
    if type(func) == "function" then
        local ok, source, line, name = pcall(debug.info, func, "sln")
        if ok then
            table.insert(parts, ("%s at %s:%s"):format(name ~= "" and name or "<anonymous>", source, line))
        end
        local okEnv, env = pcall(getfenv, func)
        local script = okEnv and type(env) == "table" and rawget(env, "script")
        if typeof(script) == "Instance" then
            table.insert(parts, "script: " .. script:GetFullName())
        end
    else
        table.insert(parts, "no Lua function")
    end
    return table.concat(parts, "  |  ")
end

function Do.openConnections(anchor, targets)
    local items = {}
    for _, name in ipairs(Do.membersOf(targets[1].ClassName, "#E")) do
