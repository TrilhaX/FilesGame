            action = function()
                viewLater("Connections: " .. name, function()
                    if not getconnections then
                        return "-- View Connections needs getconnections"
                    end
                    local lines = {}
                    for _, inst in ipairs(targets) do
                        table.insert(lines, ("-- %s.%s"):format(getPath(inst), name))
                        local ok, list = pcall(function()
                            return getconnections(inst[name])
                        end)
                        if ok then
                            for i, connection in ipairs(list) do
