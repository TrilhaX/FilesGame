-- Visual effects that disappear along with a hidden Model or Folder.
local EFFECTS = { "ParticleEmitter", "Trail", "Beam", "Light", "Fire", "Smoke", "Sparkles", "Highlight" }

local function record(list, obj, prop, value)
    local ok, current = pcall(function()
        return obj[prop]
    end)
    if ok and current ~= value and pcall(function()
        obj[prop] = value
    end) then
        table.insert(list, { obj, prop, current })
    end
end

local function hideVisual(list, obj)
    if obj:IsA("BasePart") or obj:IsA("Decal") then
        record(list, obj, "Transparency", 1)
    elseif obj:IsA("GuiObject") then
        record(list, obj, "Visible", false)
    elseif obj:IsA("LayerCollector") then
        record(list, obj, "Enabled", false)
    else
        for _, className in ipairs(EFFECTS) do
            if obj:IsA(className) then
                record(list, obj, "Enabled", false)
                break
            end
        end
    end
end

local function hasEnabled(inst)
    local ok, value = pcall(function()
        return inst.Enabled
    end)
    return ok and type(value) == "boolean"
end

-- "Hide" for visual things, "Disable" for the rest; nil if not applicable.
local function hideMode(inst)
    if inst == game or inst.Parent == game or inst == workspace then
        return nil
    end
    if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("GuiObject")
        or inst:IsA("Model") or inst:IsA("Folder") then
        return "Hide"
    end
    if hasEnabled(inst) then
        return inst:IsA("LayerCollector") and "Hide" or "Disable"
    end
    return nil
end

local function hideItem(inst, mode)
    local list = {}
    if mode == "Disable" then
        record(list, inst, "Enabled", false)
    else
        hideVisual(list, inst)
        if inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Folder") then
            for _, d in ipairs(inst:GetDescendants()) do
                hideVisual(list, d)
            end
        end
    end
    if #list == 0 then
        notify("Nothing to change", true)
        return
    end
    local entry = { mode = mode, list = list }
    -- Not in `connections`: the entry outlives this run (kept in getgenv).
    local okConn, conn = pcall(function()
        return inst.Destroying:Connect(function()
            if hiddenItems[inst] == entry then
                hiddenItems[inst] = nil
            end
        end)
    end)
    entry.destroyConn = okConn and conn or nil
    hiddenItems[inst] = entry
    notify(mode == "Disable" and "Disabled" or "Hidden")
end

local function restoreItem(inst)
    local entry = hiddenItems[inst]
    for _, item in ipairs(entry.list) do
        pcall(function()
            item[1][item[2]] = item[3]
        end)
    end
    if entry.destroyConn then
        entry.destroyConn:Disconnect()
    end
    hiddenItems[inst] = nil
    local isScript = inst:IsA("BaseScript")
    notify(entry.mode == "Disable" and (isScript and "Enabled (script restarted)" or "Enabled") or "Shown")
end

