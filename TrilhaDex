reveal = function(inst)
    local chain = {}
    local current = inst
    while current and current ~= game do
        table.insert(chain, 1, current)
        current = current.Parent
    end
    local node = current == game and GAME_NODE or NIL_NODE
    if not node then
        return
    end

    for _, item in ipairs(chain) do
        if not node.expanded or not node.children or node.isStale or node == NIL_NODE then
            node.expanded = true
            loadChildren(node)
        end
        node = nodes[item]
        if not node then
            selectInstance(inst)
            return
        end
    end

    searchToken += 1
    if searchBox.Text ~= "" then
        searchBox.Text = ""
    end
    results = nil
    visibleRows = list
    rebuild()
    updateCanvas()
    local index = table.find(list, node)
    if index then
        local height = treeList.AbsoluteSize.Y
        treeList.CanvasPosition = Vector2.new(0, math.max(0, (index - 1) * ROW_H - height / 2))
    end
    selectInstance(inst)
end

-- Tree updates: events only mark the parent; the loop re-reads in batches.
local function markDirty(parent)
    local node = parent and nodes[parent]
    if node then
        dirty[node] = true
    end
end

connect(game.DescendantAdded, function(inst)
    markDirty(inst.Parent)
end)
connect(game.DescendantRemoving, function(inst)
