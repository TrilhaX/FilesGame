-- Tools: click to select, rejoin and the display settings.
local clickMode, clickConn

function Do.setClickMode(mode)
    if clickConn then
        clickConn:Disconnect()
        clickConn = nil
    end
    clickMode = mode ~= clickMode and mode or nil
    if not clickMode then
        return
    end
    clickConn = connect(UIS.InputBegan, function(input, processed)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        -- Geometry test: MouseEnter/MouseLeave are unreliable with touch.
        local pos = input.Position
        local topLeft, size = main.AbsolutePosition, main.AbsoluteSize
        local insideMain = pos.X >= topLeft.X and pos.X <= topLeft.X + size.X
            and pos.Y >= topLeft.Y and pos.Y <= topLeft.Y + size.Y
        local hovering = input.UserInputType == Enum.UserInputType.MouseButton1 and pointerOverMain
        if insideMain or hovering or modalBackdrop.Visible or menuBackdrop.Visible then
            return
        end
        local target
        if clickMode == "part" then
            if processed then
                return
            end
            local camera = workspace.CurrentCamera
            local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
            local hit = workspace:Raycast(ray.Origin, ray.Direction * 5000)
            target = hit and hit.Instance
        else
            local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
            local found = playerGui and playerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
            target = found and found[1]
        end
        if target then
            reveal(target)
        end
    end)
end

