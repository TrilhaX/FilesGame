        for _, l in ipairs(rows) do
            l.BackgroundColor3 = color
        end
    end

    resizeHandle.MouseEnter:Connect(function()
        paint(COLOR.violet)
    end)
    resizeHandle.MouseLeave:Connect(function()
        if not activeInput then
            paint(COLOR.muted)
        end
    end)

    resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        -- Pin the current size before lifting the limit, or the window jumps.
        baseSize, basePos = main.AbsoluteSize, main.Position
        WINDOW_SIZE = UDim2.fromOffset(baseSize.X, baseSize.Y)
        main.Size = WINDOW_SIZE
        mainLimit.MaxSize = Vector2.new(math.huge, math.huge)
        activeInput, startPos = input, input.Position
        paint(COLOR.violet)
    end)

    connect(UIS.InputChanged, function(input)
        if not activeInput or (input ~= activeInput
            and input.UserInputType ~= Enum.UserInputType.MouseMovement) then
            return
        end
        local screen = gui.AbsoluteSize
        local l = math.floor(math.clamp(baseSize.X + input.Position.X - startPos.X, MIN_W, math.max(MIN_W, screen.X)))
        local a = math.floor(math.clamp(baseSize.Y + input.Position.Y - startPos.Y, MIN_H, math.max(MIN_H, screen.Y)))
        WINDOW_SIZE = UDim2.fromOffset(l, a)
        main.Size = WINDOW_SIZE
        -- The top-left corner stays put: the anchor is the center.
        main.Position = UDim2.new(
            basePos.X.Scale, basePos.X.Offset + (l - baseSize.X) / 2,
            basePos.Y.Scale, basePos.Y.Offset + (a - baseSize.Y) / 2
        )
    end)

    connect(UIS.InputEnded, function(input)
        if activeInput and (input == activeInput
            or input.UserInputType == Enum.UserInputType.MouseButton1) then
            activeInput = nil
            paint(COLOR.muted)
        end
    end)
end

