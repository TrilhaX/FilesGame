local function textField(row, area, initialValue)
    local offset = 0
    local swatch
    if row.kind == "Color3" or row.kind == "BrickColor" then
        offset = 20
        swatch = create("TextButton", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(16, 16),
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
        }, area)
        corner(swatch, 3)
        swatch.MouseButton1Click:Connect(function()
            if row.kind == "BrickColor" then
                brickPalette(swatch, row)
                return
            end
            local ok, current = readValue(row)
            if ok then
                openColorPicker(swatch, current, function(color)
                    applyValue(row, color)
                end)
            end
        end)
    end
    local function paintSwatch(value)
        if swatch and value ~= nil then
            swatch.BackgroundColor3 = row.kind == "Color3" and value or value.Color
        end
    end
    paintSwatch(initialValue)

    local box = textBox({
        Position = UDim2.fromOffset(offset, 0),
        Size = UDim2.new(1, -offset, 1, 0),
        BackgroundColor3 = COLOR.row,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = row.lastText,
    }, area)
    create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 4) }, box)

    row.display = function(text, value)
        if not box:IsFocused() then
            box.Text = text
        end
        paintSwatch(value)
    end

    box.FocusLost:Connect(function()
        local text = box.Text
        if text == row.lastText then
            return
        end
        local okRead, current = readValue(row)
        local ok, newValue = pcall(PARSERS[row.kind], text, okRead and current or nil)
        if ok and newValue ~= nil then
            if row.kind == "CFrame" and #row.insts > 1 then
                -- Each item keeps its own rotation when only a position is typed.
                applyValue(row, function(inst)
                    return PARSERS.CFrame(text, row.read(inst))
                end)
            else
                applyValue(row, newValue)
            end
            local okAfter, after = readValue(row)
            if okAfter then
                paintSwatch(after)
            end
        else
            notify("Invalid value for " .. row.kind, true)
            box.Text = row.lastText
        end
    end)
