local Viewer = { panes = {}, split = false, lastFilled = 1, charWidth = 7.2 }
local viewLater

do
    local ok, measured = pcall(function()
        return TextService:GetTextSize(string.rep("M", 100), 12, Enum.Font.Code, Vector2.new(4000, 40)).X
    end)
    if ok and measured > 0 then
        Viewer.charWidth = measured / 100
    end

    local btnSplit = button({
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -36, 0, 4),
        Size = UDim2.fromOffset(52, 24),
        Text = "Split",
    }, modal)

    local btnCloseModal = button({
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 0, 4),
        Size = UDim2.fromOffset(24, 24),
        Text = "X",
        TextColor3 = COLOR.red,
    }, modal)

    local paneHost = create("Frame", {
        Position = UDim2.fromOffset(6, 34),
        Size = UDim2.new(1, -12, 1, -40),
        BackgroundTransparency = 1,
    }, modal)

    local function renderCode(pane)
        local visibleCount = math.ceil(pane.list.AbsoluteSize.Y / CODE_ROW_H) + 2
        while #pane.pool < visibleCount do
            local frame = create("Frame", { BackgroundTransparency = 1, Visible = false }, pane.list)
            table.insert(pane.pool, {
                frame = frame,
                num = label({
                    Size = UDim2.new(0, 42, 1, 0),
                    TextColor3 = COLOR.muted,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Font = Enum.Font.Code,
                }, frame),
                txt = label({
                    Position = UDim2.fromOffset(52, 0),
                    Size = UDim2.new(1, -52, 1, 0),
                    RichText = true,
                    Font = Enum.Font.Code,
                }, frame),
            })
        end

        local first = math.floor(pane.list.CanvasPosition.Y / CODE_ROW_H) + 1
        for i, slot in ipairs(pane.pool) do
            local index = first + i - 1
            local text = pane.lines[index]
            if text and i <= visibleCount then
                slot.frame.Visible = true
                slot.frame.Position = UDim2.fromOffset(0, (index - 1) * CODE_ROW_H)
                slot.frame.Size = UDim2.fromOffset(pane.width, CODE_ROW_H)
                if slot.index ~= index or slot.version ~= pane.version then
                    slot.index, slot.version = index, pane.version
                    slot.num.Text = tostring(index)
                    slot.txt.Text = text
                end
            else
                slot.frame.Visible = false
            end
        end
    end

    local function applyCode(pane, rows, longest)
        pane.lines = rows
        pane.version += 1
        pane.width = math.max(pane.list.AbsoluteSize.X, 72 + longest * Viewer.charWidth)
        pane.list.CanvasPosition = Vector2.new(0, 0)
        pane.list.CanvasSize = UDim2.fromOffset(pane.width, #rows * CODE_ROW_H)
        if pendingLine and #rows >= pendingLine then
            pane.list.CanvasPosition = Vector2.new(0, math.max(0, (pendingLine - 6) * CODE_ROW_H))
            pendingLine = nil
        end
        renderCode(pane)
    end

    local function showMessage(pane, text)
        applyCode(pane, { escapeRich(text) }, #text)
    end

    local function present(pane, title, text, inst)
        pane.token += 1
        local token = pane.token
        pane.inst = inst
        pane.source = text or ""
        pane.title.Text = title
        pane.dump.Visible = inst ~= nil
        if not text then
            showMessage(pane, "-- Working...")
            return token
        end
        task.spawn(function()
            local clean = text:gsub("\r", ""):gsub("\t", "    ")
            local rows, longest = highlightLines(clean, function()
                return token == pane.token and active
            end)
            if rows and token == pane.token then
                applyCode(pane, rows, longest)
            end
        end)
        return token
    end

    local function layout()
        local first, second = Viewer.panes[1], Viewer.panes[2]
        second.frame.Visible = Viewer.split
        if not Viewer.split then
            first.frame.Position = UDim2.new()
