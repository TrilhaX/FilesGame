-- FilesGame: personal Dark Dex with explorer, properties, scripts and actions.

local env = getgenv and getgenv() or _G
if env.__FilesGameClose then
    pcall(env.__FilesGameClose)
end

local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")

local IS_TOUCH = UIS.TouchEnabled
local ROW_H = IS_TOUCH and 30 or 22
local PROP_ROW_H = IS_TOUCH and 32 or 26
local MENU_ROW_H = IS_TOUCH and 32 or 26
local CODE_ROW_H = 18
local INDENT = 12
local MAX_RESULTS = 3000

local active = true
local connections = {}
-- Extra cleanup run by close(), for state that lives outside the UI.
local closeHooks = {}

-- Kept in getgenv so hidden items stay restorable after re-executing.
local hiddenItems = env.__FilesGameHidden or {}
env.__FilesGameHidden = hiddenItems

local COLOR = {
    background = Color3.fromRGB(10, 8, 16),
    panel = Color3.fromRGB(18, 14, 28),
    item = Color3.fromRGB(28, 22, 42),
    row = Color3.fromRGB(36, 28, 54),
    violet = Color3.fromRGB(150, 95, 255),
    text = Color3.fromRGB(235, 229, 247),
    muted = Color3.fromRGB(145, 135, 168),
    red = Color3.fromRGB(235, 95, 120),
}

-- Forward declarations
local selectInstance, reveal, openActions, viewScript, render
local setSelection, buildProps, updateSelectionBoxes, openNilMenu, openDeepSearch, pendingLine
local selection, selectedSet = {}, {}

-- Display options, remembered between runs.
local SETTINGS_FILE = "One Hub/FilesGame/settings.json"
local HttpService = game:GetService("HttpService")
local settings = {
    showDeprecated = false,
    showHidden = false,
    showAttributes = true,
    showTags = true,
    selectionBoxes = true,
    forceCursor = true,
}
pcall(function()
    if isfile(SETTINGS_FILE) then
        for key, value in pairs(HttpService:JSONDecode(readfile(SETTINGS_FILE))) do
            if settings[key] ~= nil then
                settings[key] = value
            end
        end
    end
end)

local function saveSettings()
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode(settings))
    end)
end

-- UI helpers
local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(connections, c)
    return c
end

local function create(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    create("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, obj)
end

local function label(props, parent)
    local base = {
        BackgroundTransparency = 1,
        TextColor3 = COLOR.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 12,
    }
    for k, v in pairs(props) do
        base[k] = v
    end
    return create("TextLabel", base, parent)
end

local function button(props, parent)
    local base = {
        BackgroundColor3 = COLOR.item,
        BorderSizePixel = 0,
        AutoButtonColor = true,
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
    }
    for k, v in pairs(props) do
        base[k] = v
    end
    local b = create("TextButton", base, parent)
    corner(b, 5)
    return b
end

local function scrollList(props, parent)
    local base = {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = COLOR.violet,
    }
    for k, v in pairs(props) do
        base[k] = v
    end
    local s = create("ScrollingFrame", base, parent)
    create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, s)
    return s
end

-- Virtual list: no automatic layout, rows are positioned by hand.
local function virtualScroll(props, parent)
    local base = {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = COLOR.violet,
    }
    for k, v in pairs(props) do
        base[k] = v
    end
    return create("ScrollingFrame", base, parent)
end

local function textBox(props, parent)
    local base = {
        BackgroundColor3 = COLOR.panel,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        ClipsDescendants = true,
        PlaceholderColor3 = COLOR.muted,
        Text = "",
        TextColor3 = COLOR.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
    }
    for k, v in pairs(props) do
        base[k] = v
    end
    local c = create("TextBox", base, parent)
    corner(c, 5)
    return c
end

