        else
            local ok, child = pcall(function()
                return inst:FindFirstChildWhichIsA("Instance")
            end)
            node.hasChildren = ok and child ~= nil
        end
    end

    local arrowWidth = IS_TOUCH and 28 or 18
    local x = 2 + (node.depth or 0) * INDENT
    slot.arrow.Position = UDim2.fromOffset(x, 0)
    slot.arrow.Visible = node.hasChildren == true
    slot.chevron.Rotation = node.expanded and 90 or 0

    local xIcon = x + arrowWidth
    slot.icon.Position = UDim2.new(0, xIcon, 0.5, 0)
    local name = node.virtual and node.name or inst.Name
    if slot.initials then
        slot.initials.Text = node.virtual and "?" or inst.ClassName:sub(1, 2)
    else
        slot.icon.ImageRectOffset = iconOffset(node.virtual and ICON_CELL.Folder or iconCellOf(inst.ClassName, inst.Parent == game))
    end

    local xName = xIcon + 21
    local reserved = isSelected and 32 or 6
    slot.name.Size = UDim2.new(1, -xName - reserved, 1, 0)
    slot.name.Position = UDim2.fromOffset(xName, 0)
    slot.name.Text = name
    slot.name.TextColor3 = ((inst and hiddenItems[inst]) or (node.isSearch and not node.match)) and COLOR.muted or COLOR.text
    slot.moreBtn.Visible = inst ~= nil and inst == selected
    slot.frame.Visible = true
end

render = function()
    local visibleCount = math.ceil(treeList.AbsoluteSize.Y / ROW_H) + 2
    while #slotPool < visibleCount do
        table.insert(slotPool, newPoolSlot())
    end
    local first = math.floor(treeList.CanvasPosition.Y / ROW_H) + 1
    for i, slot in ipairs(slotPool) do
        local index = first + i - 1
        local node = visibleRows[index]
        if node and i <= visibleCount then
            local ok, err = pcall(paintSlot, slot, node, index)
            if not ok then
                slot.frame.Visible = false
                warn("[FilesGame] row: " .. tostring(err))
            end
        else
            slot.node = nil
            slot.frame.Visible = false
        end
    end
end

connect(treeList:GetPropertyChangedSignal("CanvasPosition"), render)
connect(treeList:GetPropertyChangedSignal("AbsoluteSize"), render)

-- Properties panel
local propRows = {}
local CollectionService = game:GetService("CollectionService")
