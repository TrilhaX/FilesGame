        { key = "name", label = "Name" },
        { key = "kind", label = "Type", options = ATTRIBUTE_TYPES },
        { key = "value", label = "Value" },
    }, function(values)
        local newValue
        if values.kind == "boolean" then
            newValue = values.value:lower():sub(1, 1) == "t"
        else
            local ok, parsed = pcall(PARSERS[values.kind], values.value)
            newValue = ok and parsed or nil
        end
        if values.name == "" or newValue == nil then
            notify("Invalid attribute", true)
            return
        end
        for _, inst in ipairs(anchorInsts) do
            local ok, err = pcall(function()
                inst:SetAttribute(values.name, newValue)
            end)
            if not ok then
                notify("Failed: " .. tostring(err), true)
            end
        end
        buildProps(selection)
    end)
end

