local function paintSlot(slot, node, index)
    slot.node = node
    local inst = node.inst
    local isSelected = inst ~= nil and selectedSet[inst] == true
    slot.frame.Position = UDim2.fromOffset(0, (index - 1) * ROW_H)
    slot.frame.BackgroundTransparency = isSelected and 0 or 1

    if node.hasChildren == nil then
        if node.virtual then
