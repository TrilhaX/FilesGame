local ICON_SHEET
do
    local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local B64_VALUE = {}
    for i = 1, 64 do
        B64_VALUE[ALPHABET:byte(i)] = i - 1
    end

    local function base64(txt)
        local clean = txt:gsub("[^%w%+/]", "")
        local parts, count = {}, 0
        for i = 1, #clean, 4 do
            local a, b, c, d = clean:byte(i, i + 3)
            local n = B64_VALUE[a] * 262144 + (b and B64_VALUE[b] or 0) * 4096
                + (c and B64_VALUE[c] or 0) * 64 + (d and B64_VALUE[d] or 0)
            local b1, b2, b3 = math.floor(n / 65536), math.floor(n / 256) % 256, n % 256
            count += 1
            parts[count] = d and string.char(b1, b2, b3)
                or c and string.char(b1, b2)
                or string.char(b1)
        end
        return table.concat(parts)
    end

    local ok, result = pcall(function()
        local FOLDER = "One Hub/FilesGame"
        for _, folder in ipairs({ "One Hub", FOLDER }) do
            if not isfolder(folder) then
                makefolder(folder)
            end
        end
        local file = FOLDER .. "/ClassIcons.png"
        writefile(file, base64(ICONS_B64))
        return getcustomasset(file)
    end)
    if ok then
        ICON_SHEET = result
    else
        warn("[FilesGame] icons: " .. tostring(result))
    end
    ICONS_B64 = nil
end

