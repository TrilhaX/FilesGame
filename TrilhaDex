-- Script viewer
local CODE_COLORS = {
    keyword = "#BE9FFF",
    text = "#96E18C",
    formatNumber = "#F5C86E",
    value = "#F587AF",
    comment = "#7D7391",
}
local KEYWORDS = {}
for p in ("local function end if then else elseif for in do while repeat until return not and or break continue"):gmatch("%a+") do
    KEYWORDS[p] = true
end
local LITERALS = { ["true"] = true, ["false"] = true, ["nil"] = true }
local ESCAPES = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;" }

local function escapeRich(t)
    return (t:gsub("[&<>]", ESCAPES))
end

-- Same idea as RemoteLog's highlighter, but returns one line at a time: tokens that
-- span lines are split so the viewer can virtualize the list.
local function highlightLines(code, shouldContinue)
    local rows, parts, lineLength, longest = {}, {}, 0, 0

    local function endLine()
        table.insert(rows, table.concat(parts))
        table.clear(parts)
        longest = math.max(longest, lineLength)
        lineLength = 0
    end

    local function write(color, chunk)
        local lineStart = 1
        while true do
            local stop = chunk:find("\n", lineStart, true)
            local part = chunk:sub(lineStart, (stop or 0) - 1)
            if part ~= "" and lineLength < 4000 then
                lineLength += #part
                local e = escapeRich(part)
                table.insert(parts, color and ('<font color="%s">%s</font>'):format(color, e) or e)
                if lineLength >= 4000 then
                    table.insert(parts, " ...")
                end
            end
            if not stop then
                break
            end
            endLine()
            lineStart = stop + 1
        end
    end

    local function longClose(eq, from)
        local _, f = code:find("]" .. eq .. "]", from, true)
        return f or #code
    end

    local pos, n, tokens = 1, #code, 0
    while pos <= n do
        tokens += 1
        if tokens % 6000 == 0 then
            task.wait()
            if not shouldContinue() then
                return nil
            end
        end

        local c = code:sub(pos, pos)
        local token
        if c == "-" and code:sub(pos + 1, pos + 1) == "-" then
            local eq = code:match("^%-%-%[(=*)%[", pos)
            token = eq and code:sub(pos, longClose(eq, pos)) or code:match("^%-%-[^\n]*", pos)
            write(CODE_COLORS.comment, token)
        elseif c == "[" and code:match("^%[=*%[", pos) then
            local eq = code:match("^%[(=*)%[", pos)
            token = code:sub(pos, longClose(eq, pos))
            write(CODE_COLORS.text, token)
        elseif c == '"' or c == "'" or c == "`" then
            local target = c:byte()
            local i = pos + 1
            while i <= n do
                local b = code:byte(i)
                if b == 92 then
                    i += 2
                elseif b == target or (b == 10 and c ~= "`") then
                    break
                else
                    i += 1
                end
            end
            token = code:sub(pos, math.min(i, n))
            write(CODE_COLORS.text, token)
        elseif c:match("%d") then
            token = code:match("^0[xXbB][%x_]+", pos)
                or code:match("^%d[%d_%.]*[eE][-+]?%d+", pos)
                or code:match("^%d[%d_%.]*", pos)
            write(CODE_COLORS.formatNumber, token)
        elseif c:match("[%a_]") then
            token = code:match("^[%w_]+", pos)
            if KEYWORDS[token] then
                write(CODE_COLORS.keyword, token)
            elseif LITERALS[token] then
                write(CODE_COLORS.value, token)
            else
                write(nil, token)
            end
        elseif c:match("%s") then
            token = code:match("^%s+", pos)
            write(nil, token)
        else
            token = c
            write(nil, c)
        end
        pos += #token
    end
    endLine()
    return rows, longest
end

