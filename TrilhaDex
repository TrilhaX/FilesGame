    setStatus("Searching...")
    task.delay(0.25, function()
        if token ~= searchToken or not active then
            return
        end
        local ok, err = pcall(runSearch, token, searchTerm)
        if not ok then
            notify("Search failed: " .. tostring(err), true)
        end
    end)
end

