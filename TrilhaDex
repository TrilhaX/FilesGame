do
local Do = {}
-- Actions on the selection
local clip = { items = {}, wasCut = false }

function Do.isProtected(inst)
    return inst == game or inst.Parent == game
end

function Do.cloneOf(inst)
    local before = inst.Archivable
    pcall(function()
        inst.Archivable = true
    end)
    local ok, copy = pcall(function()
        return inst:Clone()
    end)
    pcall(function()
        inst.Archivable = before
    end)
    return ok and copy or nil
end

function Do.markParents(insts)
    for _, inst in ipairs(insts) do
        local node = nodes[inst]
        if node and node.parent then
            dirty[node.parent] = true
        elseif NIL_NODE then
            dirty[NIL_NODE] = true
        end
    end
end

-- Drops targets whose ancestor is also a target, so actions keep the hierarchy.
function Do.topLevel(targets)
    local set = {}
    for _, inst in ipairs(targets) do
        set[inst] = true
    end
    local out = {}
    for _, inst in ipairs(targets) do
        local parent = inst.Parent
        local nested = false
        while parent do
            if set[parent] then
                nested = true
                break
            end
            parent = parent.Parent
        end
        if not nested then
            table.insert(out, inst)
        end
    end
    return out
end

function Do.copyItems(targets)
    targets = Do.topLevel(targets)
    local copies = {}
    for _, inst in ipairs(targets) do
        local copy = Do.cloneOf(inst)
        if copy then
            table.insert(copies, copy)
        end
    end
    clip.items, clip.wasCut = copies, false
    notify(#copies .. " copied")
end

function Do.cutItems(targets)
    targets = Do.topLevel(targets)
    local moved = {}
    Do.markParents(targets)
    for _, inst in ipairs(targets) do
        if not Do.isProtected(inst) and pcall(function()
            inst.Parent = nil
        end) then
            table.insert(moved, inst)
        end
    end
    clip.items, clip.wasCut = moved, true
    setSelection({})
    notify(#moved .. " cut")
end

function Do.pasteInto(parents)
    local created = {}
    local keepCut = false
    for _, parent in ipairs(parents) do
        for i, item in ipairs(clip.items) do
            if clip.wasCut then
                -- The original moves once; later pastes use a copy of it.
                local spare = Do.cloneOf(item)
                if pcall(function()
                    item.Parent = parent
                end) then
                    table.insert(created, item)
                    if spare then
                        clip.items[i] = spare
                    end
                else
                    keepCut = true
                    if spare then
                        spare:Destroy()
                    end
                end
            else
                local copy = Do.cloneOf(item)
                if copy and pcall(function()
                    copy.Parent = parent
                end) then
                    table.insert(created, copy)
                end
            end
        end
        -- A failed move keeps the original cut so the next paste can place it.
        clip.wasCut = keepCut
        keepCut = false
        markDirty(parent)
    end
    setSelection(created)
    notify(#created .. " pasted")
end

function Do.duplicateItems(targets)
    targets = Do.topLevel(targets)
    local created = {}
    for _, inst in ipairs(targets) do
        local copy = not Do.isProtected(inst) and Do.cloneOf(inst)
        if copy and pcall(function()
            copy.Parent = inst.Parent
        end) then
            table.insert(created, copy)
        end
    end
    Do.markParents(targets)
    setSelection(created)
end

function Do.deleteItems(targets)
    local removed = {}
    local failure
    Do.markParents(targets)
    for _, inst in ipairs(targets) do
        if not Do.isProtected(inst) then
            local ok, err = pcall(function()
                inst:Destroy()
            end)
            if ok then
                removed[inst] = true
            else
                failure = err
            end
        end
    end
    if failure then
        notify("Delete failed: " .. tostring(failure), true)
    else
        notify("Deleted")
    end
    setSelection({})
    if results then
        startSearch()
    end
end

function Do.groupItems(targets)
    targets = Do.topLevel(targets)
    local first
    for _, inst in ipairs(targets) do
        if not Do.isProtected(inst) and inst.Parent then
            first = inst
            break
        end
    end
    if not first then
        notify("Nothing to group", true)
        return
    end
    local parent = first.Parent
    local model = Instance.new("Model")
    if not pcall(function()
        model.Parent = parent
    end) then
        model:Destroy()
        notify("Cannot group here", true)
        return
    end
    for _, inst in ipairs(targets) do
        if not Do.isProtected(inst) then
            pcall(function()
                inst.Parent = model
            end)
        end
    end
    markDirty(parent)
    setSelection({ model })
end

function Do.ungroupItems(targets)
    local released = {}
    for _, inst in ipairs(targets) do
        if not Do.isProtected(inst) and (inst:IsA("Model") or inst:IsA("Folder")) then
            local parent = inst.Parent
            local failed = 0
            for _, child in ipairs(inst:GetChildren()) do
                if pcall(function()
                    child.Parent = parent
                end) then
                    table.insert(released, child)
                else
                    failed += 1
                end
            end
            -- Only remove the container when it is really empty.
            if failed == 0 and #inst:GetChildren() == 0 then
                pcall(function()
                    inst:Destroy()
                end)
            else
                notify(inst.Name .. ": " .. failed .. " children could not move; kept container", true)
            end
            markDirty(parent)
        end
    end
    setSelection(released)
end

