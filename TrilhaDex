function Do.expandAll(targets)
    local budget = 3000
    local function open(node)
        if budget <= 0 then
            return
        end
        node.expanded = true
        if not node.children or node.isStale then
            loadChildren(node)
        end
        for _, child in ipairs(node.children) do
            budget -= 1
            open(child)
        end
    end
    for _, inst in ipairs(targets) do
        if nodes[inst] then
            open(nodes[inst])
        end
    end
    rebuild()
    updateCanvas()
    render()
end

function Do.collapseAll(targets)
