do
    local MIN_W, MIN_H = 440, 280
    local rows = {}
    local activeInput, startPos, baseSize, basePos

    for i = 1, 3 do
        rows[i] = create("Frame", {
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -3, 1, -3 - (i - 1) * 4),
            Size = UDim2.fromOffset(2 + (i - 1) * 4, 2),
