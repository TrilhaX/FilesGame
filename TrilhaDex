local function collectInstances()
    local all = game:GetDescendants()
    if getnilinstances then
        for _, root in ipairs(getnilinstances()) do
            table.insert(all, root)
            for _, d in ipairs(root:GetDescendants()) do
                table.insert(all, d)
            end
        end
    end
    return all
end

local function runSearch(token, term)
    local okCompile, predicate = pcall(Query.compile, term)
    if not okCompile then
        -- Old results would look like the answer to the new query.
        endSearch()
        notify("Invalid search: " .. tostring(predicate):gsub("^.-:%d+: ", ""), true)
        return
    end
    if not predicate then
        endSearch()
        return
    end

    local matches = {}
    for i, inst in ipairs(collectInstances()) do
        if i % 3000 == 0 then
            task.wait()
            if token ~= searchToken or not active then
                return
            end
        end
        local ok, hit = pcall(predicate, inst)
        if ok and hit and inst ~= gui and not inst:IsDescendantOf(gui) then
            table.insert(matches, inst)
            if #matches >= MAX_RESULTS then
                break
            end
        end
    end

    buildResultTree(matches)
    treeList.CanvasPosition = Vector2.new(0, 0)
    updateCanvas()
    render()
end

startSearch = function()
    searchToken += 1
    local token = searchToken
