    local write = access and access.write or function(target, newValue)
        target[prop.n] = newValue
    end
    local ok, value = pcall(read, inst)
    if not ok then
        return
    end

    local kind = typeof(value)
    local row = {
        inst = inst, insts = insts, name = prop.n, kind = kind, read = read, write = write,
        isAttribute = access ~= nil,
    }
    row.lastText = rowText(row, value)
    local frame = create("Frame", {
        Size = UDim2.new(1, -6, 0, PROP_ROW_H),
        BackgroundColor3 = COLOR.item,
        BorderSizePixel = 0,
        LayoutOrder = order,
    }, propList)
    corner(frame, 4)
    row.frame = frame

    local nameBtn = create("TextButton", {
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(0.46, -10, 1, 0),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = prop.n,
        TextColor3 = (prop.ro or prop.dep) and COLOR.muted or COLOR.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Font = Enum.Font.Gotham,
        TextSize = 12,
    }, frame)
    nameBtn.MouseButton2Click:Connect(function()
        openPropMenu(nameBtn, row)
    end)
    if IS_TOUCH then
        nameBtn.MouseButton1Click:Connect(function()
            openPropMenu(nameBtn, row)
        end)
    end

    local area = create("Frame", {
        Position = UDim2.new(0.46, 0, 0, 3),
        Size = UDim2.new(0.54, -4, 1, -6),
        BackgroundTransparency = 1,
    }, frame)

    -- Long or multi-line strings are shown cut: editing would lose the rest.
    local truncated = kind == "string" and (#value > 300 or value:find("\n", 1, true) ~= nil)
    if kind == "Instance" or kind == "nil" then
        refField(row, area)
    elseif prop.ro or truncated then
        readOnlyField(row, area)
    elseif kind == "boolean" then
        boolField(row, area)
    elseif kind == "EnumItem" then
        enumField(row, area, value)
    elseif PARSERS[kind] then
        textField(row, area, value)
    else
        readOnlyField(row, area)
    end
    table.insert(propRows, row)
end

local ATTRIBUTE_TYPES = { "string", "number", "boolean", "Color3", "Vector3", "Vector2", "UDim2", "UDim" }

local function promptAddAttribute(anchorInsts)
