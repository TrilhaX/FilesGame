local function processDirty()
    -- Work on a copy: reloading a node also edits the dirty table.
    local batch = {}
    for node in pairs(dirty) do
        table.insert(batch, node)
    end
    table.clear(dirty)

    local changed = false
    for _, node in ipairs(batch) do
        changed = true
        if node ~= NIL_NODE and nodes[node.inst] ~= node then
            -- Forgotten by an earlier reload in this same batch.
        elseif node.expanded then
            loadChildren(node)
        else
            node.hasChildren = nil
            node.isStale = true
        end
    end
    if changed then
        rebuild()
        if not results then
            updateCanvas()
            render()
        end
    end
end

task.spawn(function()
    while active do
        local startPos = os.clock()
        local ok, err = pcall(processDirty)
        if not ok then
            warn("[FilesGame] tree: " .. tostring(err))
        end
        -- On huge trees the interval grows with the cost of re-reading.
        task.wait(math.max(0.25, (os.clock() - startPos) * 10))
    end
end)

