local function setStatus(text)
    statusText = text
    if noticeSeq == 0 then
        lblStatus.Text = text
        lblStatus.TextColor3 = COLOR.muted
    end
end

local function notify(text, isError)
    noticeSeq += 1
    local seq = noticeSeq
    lblStatus.Text = text
    lblStatus.TextColor3 = isError and COLOR.red or COLOR.violet
    task.delay(2.5, function()
        if seq == noticeSeq and active then
            noticeSeq = 0
            lblStatus.Text = statusText
            lblStatus.TextColor3 = COLOR.muted
        end
    end)
end

local function copyText(text, message)
    if setclipboard then
        setclipboard(text)
        notify(message or "Copied!")
    else
        notify("setclipboard unavailable", true)
    end
end

