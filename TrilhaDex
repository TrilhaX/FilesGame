local function commonGroups(insts)
    local groups = propertiesOf(insts[1].ClassName)
    local allowed
    for i = 2, #insts do
        local names = {}
        for _, group in ipairs(propertiesOf(insts[i].ClassName)) do
            for _, prop in ipairs(group.props) do
                if not allowed or allowed[prop.n] then
                    names[prop.n] = true
                end
            end
        end
        allowed = names
    end
    return groups, allowed
end

local function applyPropFilter()
    local filter = propFilter.Text:lower()
    for _, row in ipairs(propRows) do
        row.frame.Visible = filter == "" or row.name:lower():find(filter, 1, true) ~= nil
    end
end

buildProps = function(list)
    table.clear(propRows)
    for _, child in ipairs(propList:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end
    propList.CanvasPosition = Vector2.new(0, 0)

    if #list == 0 then
        lblTarget.Text = "Select an instance"
        lblTarget.TextColor3 = COLOR.muted
        return
    end

    local insts = table.clone(list)
    local primary = selected or insts[1]
    -- Rows read from insts[1]; keep it the same instance attributes/tags come from.
    local primaryIndex = table.find(insts, primary)
    if primaryIndex and primaryIndex > 1 then
        table.remove(insts, primaryIndex)
        table.insert(insts, 1, primary)
    elseif not primaryIndex then
        primary = insts[1]
    end
    lblTarget.Text = #insts == 1 and (primary.Name .. "  ·  " .. primary.ClassName) or (#insts .. " items selected")
    lblTarget.TextColor3 = COLOR.text

    local order = 0
    local groups, allowed = commonGroups(insts)
    for _, group in ipairs(groups) do
        local titled = false
        for _, prop in ipairs(group.props) do
            local visible = (not allowed or allowed[prop.n])
                and (settings.showDeprecated or not prop.dep)
                and (settings.showHidden or not prop.hid)
            if visible then
                if not titled then
                    titled = true
                    order += 1
                    sectionTitle(group.name, order)
                end
                order += 1
                local ok, err = pcall(createPropRow, insts, prop, order)
                if not ok then
                    warn("[FilesGame] " .. prop.n .. ": " .. tostring(err))
                end
            end
        end
    end

    if settings.showAttributes then
        order += 1
        sectionTitle("Attributes", order)
        local okAttr, attributes = pcall(function()
            return primary:GetAttributes()
        end)
        if okAttr then
            local names = {}
            for name in pairs(attributes) do
                table.insert(names, name)
            end
            table.sort(names)
            for _, name in ipairs(names) do
                order += 1
                pcall(createPropRow, insts, { n = name }, order, {
                    read = function(target)
                        return target:GetAttribute(name)
                    end,
                    write = function(target, newValue)
                        target:SetAttribute(name, newValue)
                    end,
                })
            end
        end
        order += 1
        addButton("+ Add Attribute", order, function()
            promptAddAttribute(insts)
        end)
    end

    if settings.showTags then
        order += 1
        sectionTitle("Tags", order)
        local okTags, tags = pcall(function()
            return primary:GetTags()
        end)
        if okTags then
            table.sort(tags)
            for _, tag in ipairs(tags) do
                order += 1
                createTagRow(insts, tag, order)
            end
        end
        order += 1
        addButton("+ Add Tag", order, function()
            promptAddTag(insts)
        end)
    end
    applyPropFilter()
end

connect(propFilter:GetPropertyChangedSignal("Text"), applyPropFilter)

setSelection = function(list, primary)
    table.clear(selection)
    table.clear(selectedSet)
    for _, inst in ipairs(list) do
        if not selectedSet[inst] then
            selectedSet[inst] = true
            table.insert(selection, inst)
        end
    end
    selected = primary or selection[#selection]
    closeMenu()
    render()
    buildProps(selection)
    updateSelectionBoxes()
end

selectInstance = function(inst)
    setSelection(inst and { inst } or {})
end

