    end
    local targets = table.clone(selection)
    if ctrl and key == Enum.KeyCode.A and results then
        setSelection(Do.matchedInstances())
    elseif #targets == 0 then
        return
    elseif ctrl and shift and key == Enum.KeyCode.V and #clip.items > 0 then
        Do.pasteInto(targets)
    elseif ctrl and key == Enum.KeyCode.C then
        Do.copyItems(targets)
    elseif ctrl and key == Enum.KeyCode.X then
        Do.cutItems(targets)
    elseif ctrl and key == Enum.KeyCode.D then
