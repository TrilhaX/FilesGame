do

local function readValue(row)
    return pcall(row.read, row.inst)
end

-- Value as valid Luau, for "Copy as Lua".
local function toLua(v)
    local t = typeof(v)
    if t == "string" then return ("%q"):format(v) end
    if t == "number" or t == "boolean" or t == "nil" or t == "EnumItem" then return tostring(v) end
    if t == "Instance" then return getPath(v) end
    if t == "Vector3" then return ("Vector3.new(%s, %s, %s)"):format(v.X, v.Y, v.Z) end
    if t == "Vector2" then return ("Vector2.new(%s, %s)"):format(v.X, v.Y) end
    if t == "CFrame" then return ("CFrame.new(%s)"):format(table.concat({ v:GetComponents() }, ", ")) end
    if t == "Color3" then
        return ("Color3.fromRGB(%d, %d, %d)"):format(v.R * 255 + 0.5, v.G * 255 + 0.5, v.B * 255 + 0.5)
    end
    if t == "BrickColor" then return ("BrickColor.new(%q)"):format(v.Name) end
    if t == "UDim" then return ("UDim.new(%s, %s)"):format(v.Scale, v.Offset) end
    if t == "UDim2" then
        return ("UDim2.new(%s, %s, %s, %s)"):format(v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
    end
    if t == "NumberRange" then return ("NumberRange.new(%s, %s)"):format(v.Min, v.Max) end
    return ("nil --[[ %s: %s ]]"):format(t, tostring(v))
end

local function rowText(row, value)
    local text = formatValue(value)
    for i = 2, math.min(#row.insts, 50) do
        local ok, other = pcall(row.read, row.insts[i])
        if ok and formatValue(other) ~= text then
            return "(multiple)"
        end
    end
    return text
end

-- light: periodic refresh; compares across the selection only when the first item changed.
refreshRow = function(row, light)
    local ok, value = readValue(row)
    if not ok then
        return
    end
    local primaryText = formatValue(value)
    if light and primaryText == row.primaryText then
        return
    end
    row.primaryText = primaryText
    local text = rowText(row, value)
    if text ~= row.lastText then
        row.lastText = text
        row.display(text, value)
    end
end

-- newValue may be a function(inst) for values built per instance.
local function applyValue(row, newValue)
    local failure
    for _, inst in ipairs(row.insts) do
        local ok, err = pcall(function()
            local value = newValue
            if type(newValue) == "function" then
                value = newValue(inst)
            end
            row.write(inst, value)
        end)
        if not ok then
            failure = err
        end
    end
    if failure then
        notify("Failed: " .. tostring(failure), true)
    end
    row.display(row.lastText)
    refreshRow(row)
end

