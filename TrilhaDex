do
-- Search: Studio-style filter language compiled into one predicate.
local Query = {}

local OPERATORS = { ["=="] = 1, ["~="] = 1, ["!="] = 1, [">="] = 1, ["<="] = 1, ["="] = 1, [">"] = 1, ["<"] = 1 }

function Query.tokenize(text)
    local tokens, pos, n = {}, 1, #text
    while pos <= n do
        local c = text:sub(pos, pos)
        local two = text:sub(pos, pos + 1)
        if c:match("%s") then
            pos += 1
        elseif c == "(" or c == ")" then
            table.insert(tokens, { kind = c })
            pos += 1
        elseif OPERATORS[two] then
            table.insert(tokens, { kind = "op", text = two })
            pos += 2
        elseif OPERATORS[c] then
            table.insert(tokens, { kind = "op", text = c })
            pos += 1
        else
            local parts, quoted, lead = {}, false, nil
            while pos <= n do
                local ch = text:sub(pos, pos)
                if ch == '"' then
                    -- Text before the first quote, so tag:"a b" keeps its prefix.
                    lead = lead or table.concat(parts)
                    quoted = true
                    local close = text:find('"', pos + 1, true) or (n + 1)
                    table.insert(parts, text:sub(pos + 1, close - 1))
                    pos = close + 1
                elseif ch:match("%s") or ch == "(" or ch == ")" or OPERATORS[ch] or ch == "~" or ch == "!" then
                    break
                else
                    table.insert(parts, ch)
                    pos += 1
                end
            end
            if #parts == 0 then
                pos += 1
            else
                table.insert(tokens, { kind = "word", text = table.concat(parts), quoted = quoted, lead = lead })
            end
        end
    end
    return tokens
end

local PROP_NAMES, CLASS_NAMES

function Query.index()
    if PROP_NAMES then
        return PROP_NAMES, CLASS_NAMES
    end
    PROP_NAMES, CLASS_NAMES = {}, {}
    for className in pairs(API) do
        CLASS_NAMES[className:lower()] = className
        for _, group in ipairs(propertiesOf(className)) do
            for _, prop in ipairs(group.props) do
                PROP_NAMES[prop.n:lower()] = prop.n
            end
        end
    end
    return PROP_NAMES, CLASS_NAMES
end

local exactEnum = {}

local function enumHasName(enumType, name)
    local key = tostring(enumType)
    exactEnum[key] = exactEnum[key] or {}
    if exactEnum[key][name] == nil then
        local found = false
        for _, item in ipairs(enumType:GetEnumItems()) do
            if item.Name:lower() == name then
                found = true
                break
            end
        end
        exactEnum[key][name] = found
    end
    return exactEnum[key][name]
end

-- True when the value satisfies "value op wanted".
local function compareValue(value, op, wanted)
    local kind = typeof(value)
    local negate = op == "~=" or op == "!="
    local equalOp = op == "=" or op == "==" or negate
    local result

    if kind == "boolean" then
        local letter = wanted:lower():sub(1, 1)
        result = (letter == "t") == value and (letter == "t" or letter == "f")
    elseif kind == "number" then
        local n = tonumber(wanted)
        if not n then
            return false
        end
        if op == ">" then return value > n end
        if op == "<" then return value < n end
        if op == ">=" then return value >= n end
        if op == "<=" then return value <= n end
        result = math.abs(value - n) < 1e-3
    elseif not equalOp then
        return false
    elseif kind == "string" then
        result = value:lower() == wanted:lower()
    elseif kind == "EnumItem" then
        local name = value.Name:lower()
        local target = wanted:lower()
        result = name == target or (not enumHasName(value.EnumType, target) and name:find(target, 1, true) ~= nil)
    elseif kind == "nil" then
        result = wanted == "" or wanted:lower() == "nil"
    elseif kind == "Instance" then
        result = value.Name:lower() == wanted:lower()
    else
        local a = formatValue(value):gsub("%s", "")
        result = a:lower() == wanted:gsub("%s", ""):lower()
    end
    if negate then
        return not result
    end
    return result
end

local function propertyTerm(path, op, wanted)
    local props = Query.index()
    local head, field = path:match("^([^%.]+)%.(.+)$")
    head = head or path
    local name = props[head:lower()] or head
    return function(inst)
        local ok, value = pcall(function()
            local v = inst[name]
            if field then
                local kind = typeof(v)
                if kind == "Color3" then
                    return math.floor(v[field:upper():sub(1, 1)] * 255 + 0.5)
                end
                return v[field:sub(1, 1):upper() .. field:sub(2)]
            end
            return v
        end)
        return ok and compareValue(value, op, wanted)
    end
end

local function pathTerm(pattern)
    local parts = {}
    for part in pattern:lower():gmatch("[^%.]+") do
        table.insert(parts, part)
    end

    local function matches(chain, ci, pi)
        if pi > #parts then
            return ci > #chain
        end
        local part = parts[pi]
        if part == "**" then
            for next = ci + 1, #chain + 1 do
                if matches(chain, next, pi + 1) then
                    return true
                end
            end
            return false
        end
        if ci > #chain then
            return false
        end
        if part ~= "*" and chain[ci] ~= part then
            return false
        end
        return matches(chain, ci + 1, pi + 1)
    end

    return function(inst)
        local chain = {}
        local current = inst
        while current and current ~= game do
            table.insert(chain, 1, current.Name:lower())
            current = current.Parent
        end
        for start = 1, #chain do
            if matches(chain, start, 1) then
                return true
            end
        end
        return false
    end
end

function Query.parseExtra(word, tokens, state)
    local extra = word:lower()
    if extra == "/remotes" then
        return function(inst)
            return inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("UnreliableRemoteEvent")
        end
    elseif extra == "/bindables" then
        return function(inst)
            return inst:IsA("BindableEvent") or inst:IsA("BindableFunction")
        end
    elseif extra == "/players" then
        return function(inst)
            return inst:IsA("Player")
        end
    elseif extra == "/loadedmodules" then
        local set = {}
        if getloadedmodules then
            for _, module in ipairs(getloadedmodules()) do
                set[module] = true
            end
        end
        return function(inst)
            return set[inst] == true
        end
    elseif extra == "/rad" then
        local radius = tonumber(tokens[state.pos] and tokens[state.pos].text) or 50
        if tokens[state.pos] and tonumber(tokens[state.pos].text) then
            state.pos += 1
        end
        local character = Players.LocalPlayer and Players.LocalPlayer.Character
        local origin = character and character:GetPivot().Position
        return function(inst)
            if not origin or not inst:IsA("BasePart") then
                return false
            end
            return (inst.Position - origin).Magnitude <= radius
        end
    end
    return nil
end

function Query.parseTerm(tokens, state)
    local token = tokens[state.pos]
    if not token or token.kind ~= "word" then
        error("expected a term")
    end
    state.pos += 1
    local word = token.text

    local following = tokens[state.pos]
    if following and following.kind == "op" and not token.quoted then
        state.pos += 1
        local valueToken = tokens[state.pos]
        local wanted = ""
        if valueToken and valueToken.kind == "word" then
            wanted = valueToken.text
            state.pos += 1
        end
        return propertyTerm(word, following.text, wanted)
    end

    local quotedPrefix = token.quoted and token.lead and token.lead:match("^(%a+):$")
    if not token.quoted or quotedPrefix then
        if not token.quoted and word:sub(1, 1) == "/" then
            local extra = Query.parseExtra(word, tokens, state)
            if extra then
                return extra
            end
        end
        local prefix, rest = word:match("^(%a+):(.*)$")
        if prefix then
            prefix = prefix:lower()
            local _, classes = Query.index()
            if prefix == "is" then
                local className = classes[rest:lower()] or rest
                return function(inst)
                    return inst:IsA(className)
                end
            elseif prefix == "c" or prefix == "classname" then
                local className = rest:lower()
                return function(inst)
                    return inst.ClassName:lower() == className
                end
            elseif prefix == "tag" then
                return function(inst)
                    return inst:HasTag(rest)
                end
            elseif prefix == "name" then
                local lowered = rest:lower()
                return function(inst)
                    return inst.Name:lower():find(lowered, 1, true) ~= nil
                end
            end
        end
        if not token.quoted and word:find("*", 1, true) then
            return pathTerm(word)
        end
    end

    local lowered = word:lower()
    return function(inst)
        return inst.Name:lower():find(lowered, 1, true) ~= nil
    end
end

function Query.isWord(token, word)
    return token and token.kind == "word" and not token.quoted and token.text:lower() == word
end

function Query.parseUnary(tokens, state)
    local token = tokens[state.pos]
    if Query.isWord(token, "not") then
        state.pos += 1
        local inner = Query.parseUnary(tokens, state)
        return function(inst)
            return not inner(inst)
        end
    end
    if token and token.kind == "(" then
        state.pos += 1
        local inner = Query.parseOr(tokens, state)
        if tokens[state.pos] and tokens[state.pos].kind == ")" then
            state.pos += 1
        end
        return inner
    end
    return Query.parseTerm(tokens, state)
end

function Query.parseAnd(tokens, state)
    local left = Query.parseUnary(tokens, state)
    while true do
        local token = tokens[state.pos]
        if Query.isWord(token, "and") then
            state.pos += 1
        elseif not token or token.kind == ")" or Query.isWord(token, "or") then
            return left
        end
        local right = Query.parseUnary(tokens, state)
        local previous = left
        left = function(inst)
            return previous(inst) and right(inst)
        end
    end
end

function Query.parseOr(tokens, state)
    local left = Query.parseAnd(tokens, state)
    while Query.isWord(tokens[state.pos], "or") do
        state.pos += 1
        local right = Query.parseAnd(tokens, state)
        local previous = left
        left = function(inst)
            return previous(inst) or right(inst)
        end
    end
    return left
end

function Query.compile(text)
    local tokens = Query.tokenize(text)
    if #tokens == 0 then
        return nil
    end
    local state = { pos = 1 }
    local predicate = Query.parseOr(tokens, state)
    if state.pos <= #tokens then
        error("unexpected '" .. (tokens[state.pos].text or tokens[state.pos].kind) .. "'")
    end
    return predicate
end

-- Autocomplete: replaces the word being typed.
local SEARCH_KEYWORDS = { "is:", "c:", "classname:", "tag:", "name:", "/remotes", "/bindables", "/players", "/loadedmodules", "/rad " }

local function searchSuggestions(text)
    local before, word = text:match("^(.-)([^%s%(%)]*)$")
    if text == "" then
        return SEARCH_KEYWORDS, before, word
    end
    local results = {}
    local props, classes = Query.index()
    local prefix, rest = word:match("^(%a+):(.*)$")
    local function collect(pool, lead, needle, suffix)
        local names = {}
        for lowered, proper in pairs(pool) do
            if lowered:sub(1, #needle) == needle then
                table.insert(names, proper)
            end
        end
        table.sort(names)
        for i = 1, math.min(#names, 8) do
            table.insert(results, lead .. names[i] .. suffix)
        end
    end
    if prefix and (prefix:lower() == "is" or prefix:lower() == "c" or prefix:lower() == "classname") then
        collect(classes, prefix .. ":", rest:lower(), "")
    elseif prefix and prefix:lower() == "tag" then
        local tags = {}
        local ok, all = pcall(function()
            return CollectionService:GetAllTags()
        end)
        if ok then
            for _, tag in ipairs(all) do
                tags[tag:lower()] = tag
            end
        end
        collect(tags, "tag:", rest:lower(), "")
    elseif #word >= 2 or word:sub(1, 1) == "/" then
        for _, keyword in ipairs(SEARCH_KEYWORDS) do
            if keyword:sub(1, #word):lower() == word:lower() then
                table.insert(results, keyword)
            end
        end
        collect(props, "", word:lower(), "")
    end
    return results, before, word
end

