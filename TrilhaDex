-- Deep Search: looks inside module tables, remote traffic, script source and instance values.
do
    local Deep = {}
    Deep.MAX_HITS = 3000
    Deep.MAX_CALLS_PER_REMOTE = 40
    Deep.MAX_CLONED_VALUES = 2000
    -- Weak keys: destroyed remotes drop out once nothing else holds them.
    Deep.captured = setmetatable({}, { __mode = "k" })
    Deep.watched = setmetatable({}, { __mode = "k" })
    Deep.capturedTotal = 0
    Deep.capturing = false

    -- seen.__count caps the whole payload, not just one table.
    function Deep.cloneValue(value, seen, depth)
        if type(value) ~= "table" then
            return value
        end
        if seen[value] then
            return seen[value]
        end
        if depth >= 8 or (seen.__count or 0) >= Deep.MAX_CLONED_VALUES then
            return {}
        end
        local copy, count = {}, 0
        seen[value] = copy
        for k, v in next, value do
            count += 1
            seen.__count = (seen.__count or 0) + 1
            if count > 400 or seen.__count > Deep.MAX_CLONED_VALUES then
                break
            end
            copy[Deep.cloneValue(k, seen, depth + 1)] = Deep.cloneValue(v, seen, depth + 1)
        end
        return copy
    end

    function Deep.storeCall(remote, call)
        local list = Deep.captured[remote]
        if not list then
            list = {}
            Deep.captured[remote] = list
        end
        table.insert(list, call)
        Deep.capturedTotal += 1
        if #list > Deep.MAX_CALLS_PER_REMOTE then
            table.remove(list, 1)
        end
        return call
    end

    -- Runs inside the hook: no namecall on Instances here, or the game's call changes method.
    function Deep.remoteSink(remote, method, phase, callOrFirst, ...)
        if not active then
            return nil
        end
        if phase == "start" then
            local args = table.pack(callOrFirst, ...)
            local seen = {}
            for i = 1, args.n do
                args[i] = Deep.cloneValue(args[i], seen, 0)
            end
            return Deep.storeCall(remote, { direction = "out", method = method, args = args })
        end
        local returned = table.pack(...)
        local seen = {}
        for i = 1, returned.n do
            returned[i] = Deep.cloneValue(returned[i], seen, 0)
        end
        callOrFirst.returned = returned
        return nil
    end

    -- One hook per game session: re-running only swaps the function it reports to.
    function Deep.installHook()
        env.__FilesGameRemoteSink = Deep.remoteSink
        if env.__FilesGameRemoteHook or not hookmetamethod or not newcclosure then
            return
        end
        env.__FilesGameRemoteHook = true
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local sink = env.__FilesGameRemoteSink
            if sink and (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" then
                local ok, call = pcall(sink, self, method, "start", ...)
                if method == "InvokeServer" and ok and call then
                    local returned = table.pack(old(self, ...))
                    pcall(sink, self, method, "return", call, table.unpack(returned, 1, returned.n))
                    return table.unpack(returned, 1, returned.n)
                end
            end
            return old(self, ...)
        end))
    end

    -- Only remotes the game already listens to: a first listener would flush
    -- the queued events that game scripts connecting later still expect.
    function Deep.watchRemote(inst)
        if Deep.watched[inst] or not getconnections then
            return
        end
        if inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent") then
            local ok, list = pcall(getconnections, inst.OnClientEvent)
            if not ok or type(list) ~= "table" or #list == 0 then
                return
            end
            Deep.watched[inst] = inst.OnClientEvent:Connect(function(...)
                if not active then
                    return
                end
                local args = table.pack(...)
                local seen = {}
                for i = 1, args.n do
                    args[i] = Deep.cloneValue(args[i], seen, 0)
                end
                Deep.storeCall(inst, { direction = "in", method = "OnClientEvent", args = args })
            end)
        end
    end

    function Deep.startCapture()
        if Deep.capturing then
            return
        end
        Deep.capturing = true
        Deep.installHook()
        -- Remotes the game connects to later are picked up by the periodic sweep.
        task.spawn(function()
            while active do
                local remotes = {}
                for _, inst in ipairs(game:GetDescendants()) do
                    if not Deep.watched[inst] and (inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent")) then
                        table.insert(remotes, inst)
                    end
                end
                for i, inst in ipairs(remotes) do
                    pcall(Deep.watchRemote, inst)
                    if i % 200 == 0 then
                        task.wait()
                    end
                end
                task.wait(5)
            end
        end)
    end

    function Deep.stop()
        if env.__FilesGameRemoteSink == Deep.remoteSink then
            env.__FilesGameRemoteSink = nil
        end
        for _, c in pairs(Deep.watched) do
            pcall(function()
                c:Disconnect()
            end)
        end
        table.clear(Deep.watched)
        table.clear(Deep.captured)
        if Deep.sourceCache then
            table.clear(Deep.sourceCache)
        end
        if Deep.hits then
            table.clear(Deep.hits)
        end
    end
    table.insert(closeHooks, Deep.stop)

    function Deep.dumpValue(value)
        local lines, count, seen = {}, 0, {}
        local function render(v, indent)
            local kind = typeof(v)
            if kind == "string" then return ("%q"):format(#v > 2000 and v:sub(1, 2000) .. "..." or v) end
            if kind == "Instance" then return getPath(v) end
            if kind ~= "table" then return tostring(v) end
            if seen[v] then return "{ --[[ already shown ]] }" end
            if next(v) == nil then return "{}" end
            seen[v] = true
            local pad = string.rep("    ", indent + 1)
            local parts = {}
            for k, item in next, v do
                count += 1
                if count > 4000 then
                    table.insert(parts, pad .. "-- more items omitted")
                    break
                end
                local keyText = type(k) == "string" and k:match("^[%a_][%w_]*$") or ("[" .. render(k, indent + 1) .. "]")
                table.insert(parts, pad .. keyText .. " = " .. render(item, indent + 1))
            end
            return "{\n" .. table.concat(parts, ",\n") .. "\n" .. string.rep("    ", indent) .. "}"
        end
        table.insert(lines, render(value, 0))
        return table.concat(lines, "\n")
    end

    function Deep.dumpCall(remote, call)
        local out = { ("-- %s (%s, %s)"):format(getPath(remote), call.direction, call.method), "" }
        local args = {}
        for i = 1, call.args.n do
            args[i] = call.args[i] == nil and false or call.args[i]
        end
        table.insert(out, "local args = " .. Deep.dumpValue(args))
        if call.returned then
            local returned = {}
            for i = 1, call.returned.n do
                returned[i] = call.returned[i] == nil and false or call.returned[i]
            end
            table.insert(out, "")
            table.insert(out, "local returned = " .. Deep.dumpValue(returned))
        end
        return table.concat(out, "\n")
    end

