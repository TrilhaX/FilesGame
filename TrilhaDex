    -- Who counts as "my player" and who is someone else, read again on every search.
    Deep.identity = nil

    function Deep.buildIdentity()
        local me = Players.LocalPlayer
        local names = { [me.Name:lower()] = true, [me.DisplayName:lower()] = true, [tostring(me.UserId)] = true }
        local otherNames, otherIds, others = {}, {}, {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= me then
                others[player] = true
                otherNames[player.Name:lower()] = true
                otherNames[tostring(player.UserId)] = true
                otherIds[player.UserId] = true
            end
        end
        Deep.identity = {
            me = me, character = me.Character, userId = me.UserId, names = names,
            others = others, otherNames = otherNames, otherIds = otherIds,
        }
    end

    function Deep.isPlayerValue(value)
        local kind = typeof(value)
        if kind == "string" then
            return Deep.identity.names[value:lower()] == true
        elseif kind == "number" then
            return value == Deep.identity.userId
        elseif kind == "Instance" then
            return value == Deep.identity.me or value == Deep.identity.character
                or value:IsDescendantOf(Deep.identity.me)
                or (Deep.identity.character ~= nil and value:IsDescendantOf(Deep.identity.character))
        end
        return false
    end

    function Deep.tableMentionsPlayer(tbl)
        for key, value in next, tbl do
            if Deep.isPlayerValue(key) or Deep.isPlayerValue(value) then
                return true
            end
        end
        return false
    end

    -- Inside the player or character, or under something named after the player.
    function Deep.belongsToPlayer(inst)
        local current = inst
        while current and current ~= game do
            if current == Deep.identity.me or current == Deep.identity.character
                or Deep.identity.names[current.Name:lower()] then
                return true
            end
            current = current.Parent
        end
        return false
    end

    function Deep.mentionsOtherPlayer(args)
        local seen, count = {}, 0
        local function walk(value)
            local kind = typeof(value)
            if kind == "string" then
                return Deep.identity.otherNames[value:lower()] == true
            elseif kind == "number" then
                return Deep.identity.otherIds[value] == true
            elseif kind == "Instance" then
                if Deep.identity.others[value] then
                    return true
                end
                for other in pairs(Deep.identity.others) do
                    if other.Character and value:IsDescendantOf(other.Character) then
                        return true
                    end
                end
                return false
            elseif kind == "table" and not seen[value] then
                seen[value] = true
                for key, item in next, value do
                    count += 1
                    if count > 3000 then
                        return false
                    end
                    if walk(key) or walk(item) then
                        return true
                    end
                end
            end
            return false
        end
        return walk(args)
    end

    function Deep.preview(value)
        local kind = typeof(value)
        if kind == "string" then
            return ("%q"):format(value:sub(1, 120))
        end
        if kind == "table" then
            return "{...}"
        end
        if kind == "Instance" then
            return value:GetFullName()
        end
        local ok, text = pcall(tostring, value)
        return ok and text or kind
    end

    function Deep.keyLabel(key)
        if type(key) == "string" then
            return key:match("^[%a_][%w_]*$") and ("." .. key) or ("[%q]"):format(key)
        end
        return "[" .. Deep.preview(key) .. "]"
    end

    -- Walks a table without recursion and reports every key or value that matches.
    function Deep.scanTable(root, rootPath, query, numberQuery, token, onHit)
        local readConstants = getconstants or (debug and debug.getconstants)
        local onlyPlayer = Deep.scopes.player
        local stack = { { root, rootPath, false } }
        local seen = { [root] = true }
        local visited = 0

        local function matchesValue(value)
            local kind = typeof(value)
            if kind == "string" then
                return value:lower():find(query, 1, true) ~= nil
            elseif kind == "number" then
                return numberQuery ~= nil and value == numberQuery
            elseif kind == "Instance" then
                return value.Name:lower():find(query, 1, true) ~= nil
            elseif kind == "EnumItem" then
                return value.Name:lower():find(query, 1, true) ~= nil
            end
            return false
        end

        while #stack > 0 do
            local entry = table.remove(stack)
            local current, path = entry[1], entry[2]
            local owned = entry[3] or (onlyPlayer and Deep.tableMentionsPlayer(current))
            -- Snapshot first: the loop yields, and the game may add keys meanwhile.
            local keys, values = {}, {}
            for key, value in next, current do
                table.insert(keys, key)
                table.insert(values, value)
            end
            for index = 1, #keys do
                local key, value = keys[index], values[index]
                visited += 1
                if visited % 4000 == 0 then
                    task.wait()
                    if token ~= Deep.deepToken or not active then
                        return false
                    end
                end
                if visited > 400000 then
                    return true
                end
                local childPath = path .. Deep.keyLabel(key)
                local childOwned = owned or (onlyPlayer and Deep.isPlayerValue(key))
                if matchesValue(key) or matchesValue(value) then
                    if not onHit(childPath, value, current, childOwned) then
                        return false
                    end
                end
                if type(value) == "table" and not seen[value] and #childPath < 400 then
                    seen[value] = true
                    table.insert(stack, { value, childPath, childOwned })
                elseif type(value) == "function" then
                    local name = debug.info(value, "n")
                    if name and name ~= "" and name:lower():find(query, 1, true) then
                        if not onHit(childPath, "function " .. name, current, childOwned) then
                            return false
                        end
                    end
                    if readConstants and (not islclosure or islclosure(value)) then
                        local ok, constants = pcall(readConstants, value)
                        if ok and type(constants) == "table" then
                            for _, constant in pairs(constants) do
                                if type(constant) == "string" and constant:lower():find(query, 1, true) then
                                    if not onHit(childPath .. " (constant)", constant, current, childOwned) then
                                        return false
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
        return true
    end

    function Deep.requireLoaded(module)
        local ok, value = pcall(require, module)
        if ok then
            return true, value
        end
        if setthreadidentity then
            local previousLevel = getthreadidentity and getthreadidentity() or 8
            pcall(setthreadidentity, 2)
            ok, value = pcall(require, module)
            pcall(setthreadidentity, previousLevel)
        end
        return ok, value
    end

    function Deep.everyInstance()
        local all = game:GetDescendants()
        local seen = {}
        for _, inst in ipairs(all) do
            seen[inst] = true
        end
        local function addRoot(inst)
            if not seen[inst] then
                seen[inst] = true
                table.insert(all, inst)
                for _, d in ipairs(inst:GetDescendants()) do
                    if not seen[d] then
                        seen[d] = true
                        table.insert(all, d)
                    end
                end
            end
        end
        if getnilinstances then
            for _, inst in ipairs(getnilinstances()) do
                addRoot(inst)
            end
        end
        if getloadedmodules then
            for _, inst in ipairs(getloadedmodules()) do
                addRoot(inst)
            end
        end
        return all
    end

    Deep.sourceCache = {}

    function Deep.scanModules(query, numberQuery, token, addHit, setProgress, instances)
        local loaded = {}
        if getloadedmodules then
            for _, module in ipairs(getloadedmodules()) do
                loaded[module] = true
            end
        end
        local scanned, skipped = 0, 0
        for _, module in ipairs(instances) do
            if module.ClassName == "ModuleScript" and not module:IsDescendantOf(gui) then
                if loaded[module] then
                    -- Only modules the game already ran: require would execute the others.
                    local ok, value = Deep.requireLoaded(module)
                    scanned += 1
                    setProgress(("Modules: %d scanned"):format(scanned))
                    local moduleOwned = not Deep.scopes.player or Deep.belongsToPlayer(module)
                    if ok and type(value) == "table" then
                        local keepGoing = Deep.scanTable(value, module.Name, query, numberQuery, token, function(path, found, container, owned)
                            if not moduleOwned and not owned then
                                return true
                            end
                            return addHit({
                                kind = "Module", inst = module, where = path, detail = Deep.preview(found),
                                open = function()
                                    viewLater(path, function()
                                        return Deep.dumpValue(container)
                                    end)
                                end,
                            })
                        end)
                        if not keepGoing then
                            return false, scanned, skipped
                        end
                    elseif moduleOwned and ok and typeof(value) == "string" and value:lower():find(query, 1, true) then
                        addHit({ kind = "Module", inst = module, where = module.Name, detail = Deep.preview(value) })
                    end
                else
                    skipped += 1
                end
                if token ~= Deep.deepToken or not active then
                    return false, scanned, skipped
                end
            end
        end
        return true, scanned, skipped
    end

    function Deep.scanRemotes(query, numberQuery, token, addHit)
        local snapshot = {}
        for remote, calls in pairs(Deep.captured) do
            table.insert(snapshot, { remote, table.clone(calls) })
        end
        for _, pair in ipairs(snapshot) do
            local remote = pair[1]
            for _, call in ipairs(pair[2]) do
                -- What this client sends or asks for is its own; what arrives may be about others.
                local allowed = not Deep.scopes.player or call.direction == "out"
                    or Deep.tableMentionsPlayer(call.args) or not Deep.mentionsOtherPlayer(call.args)
                local function report(path, found)
                    if not allowed then
                        return true
                    end
                    return addHit({
                        kind = "Remote", inst = remote,
                        where = remote.Name .. " " .. call.direction .. " " .. path,
                        detail = Deep.preview(found),
                        open = function()
                            viewLater(remote.Name, function()
                                return Deep.dumpCall(remote, call)
                            end)
                        end,
                    })
                end
                for _, part in ipairs({ { call.args, "args" }, { call.returned, "returned" } }) do
                    if part[1] then
                        local data = table.clone(part[1])
                        data.n = nil
                        if not Deep.scanTable(data, part[2], query, numberQuery, token, report) then
                            return false
                        end
                    end
                end
            end
        end
        return true
    end

    function Deep.scanValues(query, numberQuery, token, addHit, instances)
        local function check(inst, what, value)
            local kind = typeof(value)
            local hit = (kind == "string" and value:lower():find(query, 1, true) ~= nil)
                or (kind == "number" and numberQuery ~= nil and value == numberQuery)
                or (kind == "Instance" and value.Name:lower():find(query, 1, true) ~= nil)
            if hit then
                return addHit({ kind = "Value", inst = inst, where = inst.Name .. " " .. what, detail = Deep.preview(value) })
            end
            return true
        end

        for i, inst in ipairs(instances) do
            if i % 2000 == 0 then
                task.wait()
                if token ~= Deep.deepToken or not active then
                    return false
                end
            end
            if inst ~= gui and not inst:IsDescendantOf(gui) and (not Deep.scopes.player or Deep.belongsToPlayer(inst)) then
                local keepGoing = true
                if inst:IsA("ValueBase") then
                    local ok, value = pcall(function()
                        return inst.Value
                    end)
                    if ok then
                        keepGoing = check(inst, ".Value", value)
                    end
                elseif inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                    keepGoing = check(inst, ".Text", inst.Text)
                end
                local okAttr, attributes = pcall(function()
                    return inst:GetAttributes()
                end)
                if keepGoing and okAttr then
                    for name, value in pairs(attributes) do
                        if name:lower():find(query, 1, true) then
                            keepGoing = addHit({ kind = "Value", inst = inst, where = inst.Name .. " @" .. name, detail = Deep.preview(value) })
                        else
                            keepGoing = check(inst, "@" .. name, value)
                        end
                        if not keepGoing then
                            break
                        end
                    end
                end
                if not keepGoing then
                    return false
                end
            end
        end
        return true
    end

    function Deep.scanSource(query, token, addHit, setProgress, instances)
        if not decompile then
            return true
        end
        local targets = {}
        for _, inst in ipairs(instances) do
            if inst:IsA("LuaSourceContainer") and not inst:IsDescendantOf(gui) then
                local okContext, context = pcall(function()
                    return inst.RunContext
                end)
                local isServerScript = inst.ClassName == "Script" and not (okContext and context == Enum.RunContext.Client)
                if not isServerScript and (not Deep.scopes.player or Deep.belongsToPlayer(inst)) then
                    table.insert(targets, inst)
                end
            end
        end
        for index, inst in ipairs(targets) do
            setProgress(("Source: %d / %d"):format(index, #targets))
            local source = Deep.sourceCache[inst]
            if source == nil then
                local ok, text = pcall(decompile, inst)
                source = ok and type(text) == "string" and text or false
                Deep.sourceCache[inst] = source
            end
            if token ~= Deep.deepToken or not active then
                return false
            end
            if source then
                local lineNumber, shown = 0, 0
                for line in (source .. "\n"):gmatch("(.-)\n") do
                    lineNumber += 1
                    if line:lower():find(query, 1, true) then
                        shown += 1
                        local at = lineNumber
                        local text = source
                        if not addHit({
                            kind = "Source", inst = inst, where = inst.Name .. ":" .. at,
                            detail = (line:gsub("^%s+", "")),
                            open = function()
                                pendingLine = at
                                viewLater(inst.Name, function()
                                    return text
                                end, inst)
                            end,
                        }) then
                            return false
                        end
                        if shown >= 15 then
                            break
                        end
                    end
                end
            end
            if index % 10 == 0 then
                task.wait()
            end
        end
        return true
    end

    function Deep.runDeepSearch()
        local query = Deep.queryBox.Text:lower()
        if query == "" then
            return
        end
        Deep.deepToken += 1
        local token = Deep.deepToken
        Deep.hits = {}
        Deep.hitList.CanvasPosition = Vector2.new(0, 0)
        Deep.hitList.CanvasSize = UDim2.new()
        Deep.renderHits()
        Deep.lblDeepStatus.Text = "Searching..."

        local numberQuery = tonumber(query)
        local lastPaint = 0
        local function publish()
            Deep.hitList.CanvasSize = UDim2.fromOffset(0, #Deep.hits * Deep.HIT_H)
            Deep.renderHits()
        end
        local function addHit(hit)
            table.insert(Deep.hits, hit)
            if os.clock() - lastPaint > 0.2 then
                lastPaint = os.clock()
                publish()
            end
            return #Deep.hits < Deep.MAX_HITS
        end
        local function setProgress(text)
            Deep.lblDeepStatus.Text = text
        end

        task.spawn(function()
            local ok, err = pcall(function()
                Deep.buildIdentity()
                local instances = Deep.everyInstance()
                local scanned, skipped = 0, 0
                local keepGoing = true
                if Deep.scopes.modules then
                    keepGoing, scanned, skipped = Deep.scanModules(query, numberQuery, token, addHit, setProgress, instances)
                end
                if keepGoing and Deep.scopes.remotes then
                    keepGoing = Deep.scanRemotes(query, numberQuery, token, addHit)
                end
                if keepGoing and Deep.scopes.values then
                    keepGoing = Deep.scanValues(query, numberQuery, token, addHit, instances)
                end
                if keepGoing and Deep.scopes.source then
                    keepGoing = Deep.scanSource(query, token, addHit, setProgress, instances)
                end
                if token ~= Deep.deepToken then
                    return
                end
                publish()
                local note = #Deep.hits >= Deep.MAX_HITS and " (limit reached)" or ""
                Deep.lblDeepStatus.Text = ("%d results%s%s  |  %d modules read, %d not loaded  |  %d remote calls captured"):format(
                    #Deep.hits, note, Deep.scopes.player and " (my player)" or "", scanned, skipped, Deep.capturedTotal)
            end)
            if not ok and token == Deep.deepToken then
                publish()
                Deep.lblDeepStatus.Text = "Failed: " .. tostring(err)
                Deep.lblDeepStatus.TextColor3 = COLOR.red
            end
        end)
    end

