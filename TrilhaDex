local nodes = {}
local dirty = {}
local list = {}
local results = nil
local visibleRows = list
local searchTerm = ""
local searchToken = 0

local PRIORITY = {}
for i, className in ipairs({
    "Workspace", "Players", "Lighting", "MaterialService", "ReplicatedFirst",
    "ReplicatedStorage", "StarterGui", "StarterPack", "StarterPlayer", "Teams",
    "SoundService", "TextChatService", "Chat", "CoreGui",
}) do
    PRIORITY[className] = ("!%02d"):format(i)
end

local function newNode(inst, parent)
    local node = { inst = inst, parent = parent, expanded = false }
    nodes[inst] = node
    return node
end

local GAME_NODE = newNode(game, nil)
local NIL_NODE = getnilinstances and { virtual = true, name = "Nil Instances", expanded = false } or nil
local roots = { GAME_NODE, NIL_NODE }

local function forget(node)
    dirty[node] = nil
    if nodes[node.inst] == node then
        nodes[node.inst] = nil
    end
    if node.children then
        for _, child in ipairs(node.children) do
            if child.parent == node then
                forget(child)
            end
        end
    end
end

local function loadChildren(node)
    local ok, instances = pcall(function()
        return node == NIL_NODE and getnilinstances() or node.inst:GetChildren()
    end)
    if not ok then
        instances = {}
    end

    local newChildren, present = {}, {}
    for _, inst in ipairs(instances) do
        if inst ~= gui then
            local child = nodes[inst] or newNode(inst, node)
            child.parent = node
            child.sortKey = node == GAME_NODE and PRIORITY[inst.ClassName] or inst.Name:lower()
            present[child] = true
            table.insert(newChildren, child)
        end
    end
    table.sort(newChildren, function(a, b)
        return a.sortKey < b.sortKey
    end)

    if node.children then
        for _, child in ipairs(node.children) do
            if not present[child] and child.parent == node then
                forget(child)
            end
        end
    end
    node.children = newChildren
    node.hasChildren = #newChildren > 0
    node.isStale = false
end

local function rebuild()
    table.clear(list)
    local n = 0
    local function visit(node, nodeDepth)
        n += 1
        list[n] = node
        node.depth = nodeDepth
        if node.expanded and node.children then
            for _, child in ipairs(node.children) do
                visit(child, nodeDepth + 1)
            end
        end
    end
    for _, root in ipairs(roots) do
        visit(root, 0)
    end
end

local function updateCanvas()
    treeList.CanvasSize = UDim2.fromOffset(0, #visibleRows * ROW_H)
    setStatus(results and (results.matchCount .. " results") or (#list .. " items"))
end

local slotPool = {}
local lastClicked, clickTime = nil, 0

local function isScript(inst)
    return inst:IsA("LuaSourceContainer")
end

-- Search results are shown as a tree: each match under its real ancestors.
local function flattenResults(tree)
    local rows = { roots = tree.roots, matchCount = tree.matchCount, matches = tree.matches }
    local count = 0
    local function visit(node, depth)
        count += 1
        rows[count] = node
        node.depth = depth
        if node.expanded then
            for _, child in ipairs(node.kids) do
                visit(child, depth + 1)
            end
        end
    end
    for _, root in ipairs(tree.roots) do
        visit(root, 0)
    end
    results = rows
    visibleRows = rows
end

local function buildResultTree(matches)
    local byInst, roots = {}, {}
    local function nodeFor(inst)
        local node = byInst[inst]
        if node then
            return node
        end
        local parent = inst.Parent
        node = {
            inst = inst, isSearch = true, expanded = true, kids = {},
            sortKey = parent == game and PRIORITY[inst.ClassName] or inst.Name:lower(),
        }
        byInst[inst] = node
        if parent and parent ~= game then
            table.insert(nodeFor(parent).kids, node)
        else
            table.insert(roots, node)
        end
        return node
    end
    for _, inst in ipairs(matches) do
        nodeFor(inst).match = true
    end

    local function order(group)
        table.sort(group, function(a, b)
            return a.sortKey < b.sortKey
        end)
        for _, node in ipairs(group) do
            node.hasChildren = #node.kids > 0
            order(node.kids)
        end
    end
    order(roots)
    flattenResults({ roots = roots, matchCount = #matches, matches = matches })
end

local function toggleNode(node)
    if node.isSearch then
        node.expanded = not node.expanded
        flattenResults(results)
        updateCanvas()
        render()
        return
    end
    node.expanded = not node.expanded
    if node.expanded and (not node.children or node.isStale or node == NIL_NODE) then
        loadChildren(node)
    end
    rebuild()
    updateCanvas()
    render()
end

local function clickRow(node)
    if node.virtual then
        toggleNode(node)
        return
    end
    local inst = node.inst
    local ctrl = multiMode or UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
    local shift = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)

    if shift and rangeAnchor then
        local from, to
        for index, row in ipairs(visibleRows) do
            if row.inst == rangeAnchor then
                from = index
            end
            if row.inst == inst then
                to = index
            end
        end
        if from and to then
            local range = {}
            for index = math.min(from, to), math.max(from, to) do
                if visibleRows[index].inst then
                    table.insert(range, visibleRows[index].inst)
                end
            end
            setSelection(range, inst)
        end
        return
    end

    if ctrl then
        rangeAnchor = inst
        local list = table.clone(selection)
        local at = table.find(list, inst)
        if at then
            table.remove(list, at)
        else
            table.insert(list, inst)
        end
        setSelection(list, not at and inst or nil)
        return
    end

    local now = os.clock()
    local isDouble = lastClicked == inst and now - clickTime < 0.35
    lastClicked, clickTime = inst, now
    rangeAnchor = inst
    if not isDouble then
        selectInstance(inst)
    elseif isScript(inst) then
        viewScript(inst)
    else
        toggleNode(node)
    end
end

